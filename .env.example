DATABASE_URL=postgres://poleia:poleia@postgres:5432/poleia?sslmode=disable
REDIS_URL=redis:6379
JWT_SECRET=change-me-to-something-long-and-random
PORT=8080

# --- Optional / tuning — all have code-side defaults, safe to leave unset ---

# Real-time tick cadence. TICK_SECONDS wins if set (lets you speed up dev,
# e.g. TICK_SECONDS=6); otherwise TICK_MINUTES x 60; otherwise 60 minutes/tick.
#TICK_SECONDS=6
#TICK_MINUTES=60

# Shared secret for the X-Admin-Key header on /admin/* god-view endpoints.
# Unset (default) = admin endpoints always answer 403.
#POLEIA_ADMIN_KEY=change-me-to-something-long-and-random

# Any non-empty value turns on the /kingdoms API + capabilities/web verbs.
# Unset (default) = kingdoms post-MVP, endpoints answer 403 "kingdoms_disabled".
#KINGDOMS_ENABLED=1

# Name used to seed the single world on first boot (world already exists on
# every later restart, so this only matters once). Default: "The Thalassa".
#WORLD_NAME=The Thalassa

# Sitos fund tunables (see temenos_sitos.md) — the guaranteed last-resort
# silver<->grain/fish counterparty per settlement. Defaults shown are the
# code fallbacks (internal/economy/sitos_config.go).
#SITOS_SUBSISTENCE_GOODS=grain,fish
#SITOS_TAX_RATE=0.01
#SITOS_REF_PRICE_FLOOR=0.5
#SITOS_REF_PRICE_CEILING=3.0
#SITOS_FUND_CAP_MULT=1
#SITOS_STARTING_FUND_DAYS=2
#SITOS_PRICE_SMOOTHING_TICKS=6
#SITOS_SILVER_CAP_DAYS=10
#SITOS_SILVER_START_DAYS=5

# Filesystem paths. Docker image bakes these in (STATIC_DIR/TEMPLATE_DIR =
# /app/web/static /app/web/templates via Dockerfile ENV) — only set these
# when running the server binary directly on the host (e.g. `air`/`go run`),
# where the defaults below (relative to server/cmd/server) are correct.
#CHRONICLE_DIR=/var/lib/poleia/chronicles
#STATIC_DIR=../../web/static
#TEMPLATE_DIR=../../web/templates
