+	raw, _ := json.Marshal(MarchRecallPayload{WorldID: f.world, UnitID: f.unitID, MessengerID: f.messengerID, Mode: "recall"})
+	err := h.Handle(ctx, events.ScheduledEvent{WorldID: f.world, Payload: raw, DueTick: 1})
